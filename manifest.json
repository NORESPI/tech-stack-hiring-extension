{
  "manifest_version": 3,
  "name": "Tech Stack & Hiring Profiler",
  "short_name": "StackHiring",
  "version": "0.1.0",
  "description": "See the technologies behind any website, 100% locally. Pro: hiring tab (open jobs from public ATS APIs) and CSV/JSON export.",
  "minimum_chrome_version": "102",
  "action": {
    "default_title": "Tech Stack & Hiring Profiler",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": [
    "https://boards-api.greenhouse.io/*",
    "https://api.lever.co/*",
    "https://api.eu.lever.co/*",
    "https://api.ashbyhq.com/*",
    "https://*.recruitee.com/*",
    "https://apply.workable.com/*",
    "https://api.smartrecruiters.com/*",
    "https://*.teamtailor.com/*",
    "https://*.jobs.personio.de/*",
    "https://*.jobs.personio.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
